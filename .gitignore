*.pem
*.p12
*.pfx
*.key
*.keystore
*.jks
key.properties
id_rsa*
id_ed25519*

# Database dumps and local backup directories
*.dump
*.backup
*.sql.gz
*.tar.gz
backups/
**/backups/

# Supabase CLI local tokens and temporary cache
.temp/
supabase/.temp/
**/.temp/

# Flutter/Dart build and tool directories
